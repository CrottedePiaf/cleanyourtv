<?xml version="1.0" encoding="utf-8"?>
<!-- One brief entrance on initial layout; ordinary HOME returns keep the existing refresh policy. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_cubic"
    android:duration="280">
    <alpha android:fromAlpha="0.0" android:toAlpha="1.0" />
    <translate android:fromYDelta="10%" android:toYDelta="0%" />
    <scale android:fromXScale="0.97" android:toXScale="1.0"
        android:fromYScale="0.97" android:toYScale="1.0"
        android:pivotX="50%" android:pivotY="50%" />
</set>
